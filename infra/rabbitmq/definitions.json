{
  "rabbit_version": "3.13.0",
  "rabbitmq_version": "3.13.0",
  "vhosts": [
    { "name": "tacamamesa" }
  ],
  "users": [
    {
      "name": "tacama_mq",
      "password_hash": "",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator",
      "limits": {}
    }
  ],
  "permissions": [
    {
      "user": "tacama_mq",
      "vhost": "tacamamesa",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "tacama.events",
      "vhost": "tacamamesa",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "tacama.dlx",
      "vhost": "tacamamesa",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "inventario.comanda-confirmada",
      "vhost": "tacamamesa",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "tacama.dlx",
        "x-message-ttl": 300000
      }
    },
    {
      "name": "inventario.comanda-anulada",
      "vhost": "tacamamesa",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "tacama.dlx"
      }
    },
    {
      "name": "analitica.eventos",
      "vhost": "tacamamesa",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "tacama.dlx"
      }
    },
    {
      "name": "tacama.dead-letters",
      "vhost": "tacamamesa",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "tacama.events",
      "vhost": "tacamamesa",
      "destination": "inventario.comanda-confirmada",
      "destination_type": "queue",
      "routing_key": "comanda.confirmada",
      "arguments": {}
    },
    {
      "source": "tacama.events",
      "vhost": "tacamamesa",
      "destination": "inventario.comanda-anulada",
      "destination_type": "queue",
      "routing_key": "comanda.anulada",
      "arguments": {}
    },
    {
      "source": "tacama.events",
      "vhost": "tacamamesa",
      "destination": "analitica.eventos",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    },
    {
      "source": "tacama.dlx",
      "vhost": "tacamamesa",
      "destination": "tacama.dead-letters",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ]
}
