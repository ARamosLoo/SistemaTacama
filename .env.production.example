# ==============================================================================
# .env.production.example — Configuración de Producción (VPS Contabo)
# Copia este archivo a .env en el VPS y completa los valores secretos.
# NUNCA compartas ni subas el archivo .env real al repositorio.
#
# Generación de contraseñas y claves seguras en terminal:
#   openssl rand -base64 32
# ==============================================================================

# ── Dominio y Certificados SSL (Let's Encrypt) ────────────────────────────────
DOMAIN=tacama-api.duckdns.org
ACME_EMAIL=tu_correo@ejemplo.com

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── PostgreSQL (Red interna Docker: host "postgres") ──────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tacama_prod_user
# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES
POSTGRES_DB=tacamamesa

# URLs de conexión por schema (Prisma multi-schema)
# Reemplazar CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES con la misma contraseña de arriba
AUTH_DATABASE_URL=postgresql://tacama_prod_user:CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES@postgres:5432/tacamamesa?schema=auth
CATALOGO_DATABASE_URL=postgresql://tacama_prod_user:CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES@postgres:5432/tacamamesa?schema=catalogo
MARIDAJE_DATABASE_URL=postgresql://tacama_prod_user:CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES@postgres:5432/tacamamesa?schema=maridaje
COMANDAS_DATABASE_URL=postgresql://tacama_prod_user:CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES@postgres:5432/tacamamesa?schema=comandas
INVENTARIO_DATABASE_URL=postgresql://tacama_prod_user:CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES@postgres:5432/tacamamesa?schema=inventario
ANALITICA_DATABASE_URL=postgresql://tacama_prod_user:CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES@postgres:5432/tacamamesa?schema=analitica

# ── Redis (Red interna Docker: host "redis") ──────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Generar con: openssl rand -base64 24
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_REDIS
REDIS_TTL_CARTA=300
REDIS_TTL_TRADUCCIONES=1800
REDIS_TTL_MARIDAJE=600

# ── RabbitMQ (Red interna Docker: host "rabbitmq") ───────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=tacama_prod_mq
# Generar con: openssl rand -base64 24
RABBITMQ_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_RABBITMQ
RABBITMQ_VHOST=tacamamesa
RABBITMQ_URL=amqp://tacama_prod_mq:CAMBIAR_POR_PASSWORD_SEGURO_RABBITMQ@rabbitmq:5672/tacamamesa

# ── JWT y Seguridad de Tokens ────────────────────────────────────────────────
# Generar claves de mínimo 32 caracteres con: openssl rand -base64 32
JWT_SECRET=CAMBIAR_POR_SECRET_JWT_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h
JWT_MESA_SECRET=CAMBIAR_POR_SECRET_MESA_AL_MENOS_32_CARACTERES
JWT_MESA_EXPIRES_IN=4h

# ── Sandbox Bodega ───────────────────────────────────────────────────────────
BODEGA_SANDBOX_URL=http://bodega-sandbox:8080/sandbox
BODEGA_SANDBOX_API_KEY=CAMBIAR_POR_API_KEY_BODEGA_32_CHARS

# ── CORS (Orígenes autorizados: apps en Vercel) ──────────────────────────────
# Separados por coma, sin espacios ni barras finales
CORS_ORIGINS=https://sistema-tacama.vercel.app,https://sistema-tacama-staff.vercel.app

