# ========================
# Variables de entorno globales — TacamaMesa
# Copia este archivo a .env y completa los valores
# NUNCA subas .env al repositorio
# ========================

# ── Entorno ──────────────────────────────────────────────
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tacama_user
POSTGRES_PASSWORD=tacama_secret_2024
POSTGRES_DB=tacamamesa

# URLs de conexión por servicio (Prisma)
AUTH_DATABASE_URL=postgresql://tacama_user:tacama_secret_2024@localhost:5432/tacamamesa?schema=auth
CATALOGO_DATABASE_URL=postgresql://tacama_user:tacama_secret_2024@localhost:5432/tacamamesa?schema=catalogo
MARIDAJE_DATABASE_URL=postgresql://tacama_user:tacama_secret_2024@localhost:5432/tacamamesa?schema=maridaje
COMANDAS_DATABASE_URL=postgresql://tacama_user:tacama_secret_2024@localhost:5432/tacamamesa?schema=comandas
INVENTARIO_DATABASE_URL=postgresql://tacama_user:tacama_secret_2024@localhost:5432/tacamamesa?schema=inventario
ANALITICA_DATABASE_URL=postgresql://tacama_user:tacama_secret_2024@localhost:5432/tacamamesa?schema=analitica

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2024
# TTL en segundos: carta=5min, traducciones=30min, maridaje=10min
REDIS_TTL_CARTA=300
REDIS_TTL_TRADUCCIONES=1800
REDIS_TTL_MARIDAJE=600

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=tacama_mq
RABBITMQ_PASSWORD=mq_secret_2024
RABBITMQ_VHOST=tacamamesa
RABBITMQ_URL=amqp://tacama_mq:mq_secret_2024@localhost:5672/tacamamesa

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=cambia_esta_clave_secreta_en_produccion_min_32chars
JWT_EXPIRES_IN=8h
JWT_MESA_SECRET=clave_secreta_token_mesa_temporal
JWT_MESA_EXPIRES_IN=4h

# ── Servicios (puertos internos) ─────────────────────────
AUTH_SERVICE_PORT=3001
CATALOGO_SERVICE_PORT=3002
MARIDAJE_SERVICE_PORT=3003
COMANDAS_SERVICE_PORT=3004
INVENTARIO_SERVICE_PORT=3005
ANALITICA_SERVICE_PORT=3006

# ── API Gateway (Traefik) ────────────────────────────────
GATEWAY_PORT=80
GATEWAY_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# ── Sandbox Bodega (adaptador simulado) ──────────────────
BODEGA_SANDBOX_URL=http://localhost:9999/sandbox
BODEGA_SANDBOX_API_KEY=sandbox_key_local

# ── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost/api/v1
VITE_SOCKET_URL=http://localhost:3004
VITE_DEFAULT_LANG=es

# ── Seguridad ────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
