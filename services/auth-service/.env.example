# auth-service — Variables de entorno
# Copia a .env y completa los valores reales

PORT=3001
NODE_ENV=development

# Base de datos (schema: auth)
DATABASE_URL=postgresql://tacama_user:tacama_secret_2024@localhost:5432/tacamamesa?schema=auth

# JWT para personal (8 horas)
JWT_SECRET=cambia_esta_clave_secreta_en_produccion_min_32chars
JWT_EXPIRES_IN=8h

# JWT para token de mesa temporal (4 horas)
JWT_MESA_SECRET=clave_secreta_token_mesa_temporal
JWT_MESA_EXPIRES_IN=4h

# Seguridad
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
