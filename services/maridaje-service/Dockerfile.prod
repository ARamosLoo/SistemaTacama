# ============================================================
# Dockerfile.prod — maridaje-service (TacamaMesa)
# Multi-stage build optimizado para monorepo pnpm
# ============================================================

# ── Etapa 1: Base ──
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
RUN npm install -g pnpm@8.15.4
WORKDIR /app

# ── Etapa 2: Dependencias ──
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages ./packages
COPY services/maridaje-service/package.json ./services/maridaje-service/
COPY services/maridaje-service/prisma ./services/maridaje-service/prisma

RUN pnpm install --frozen-lockfile

# ── Etapa 3: Build ──
FROM base AS builder
COPY --from=deps /app ./
COPY services/maridaje-service ./services/maridaje-service

# Compilar paquetes compartidos del monorepo
RUN pnpm --filter "@tacamamesa/shared-*" build
# Generar cliente de Prisma para maridaje-service
RUN pnpm --filter "@tacamamesa/maridaje-service" exec prisma generate
# Compilar microservicio con NestJS
RUN pnpm --filter "@tacamamesa/maridaje-service" build

# ── Etapa 4: Producción ──
FROM node:20-alpine AS runner
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/services/maridaje-service/dist ./services/maridaje-service/dist
COPY --from=builder /app/services/maridaje-service/generated ./services/maridaje-service/generated
COPY --from=builder /app/services/maridaje-service/prisma ./services/maridaje-service/prisma
COPY --from=builder /app/services/maridaje-service/package.json ./services/maridaje-service/package.json
COPY --from=builder /app/package.json ./package.json

WORKDIR /app/services/maridaje-service
EXPOSE 3003
CMD ["node", "dist/main.js"]

