{
  "rewrites": [
    {
      "source": "/platos/:path*",
      "destination": "https://sistema-tacama.vercel.app/platos/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://tacama-api.duckdns.org/api/v1/:path*"
    },
    {
      "source": "/((?!api/|assets/|platos/|socket.io/).*)",
      "destination": "/index.html"
    }
  ]
}
