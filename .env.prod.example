# Copia a .env en el VPS y rellena. Usa SOLO letras y numeros en las contrasenas
# (genera con: openssl rand -hex 16). NUNCA subas este archivo con valores reales.

# Dominio publico con HTTPS. Sin dominio propio usa <IP con guiones>.sslip.io
# Ej.: IP 203.0.113.7  ->  203-0-113-7.sslip.io
DOMAIN=CAMBIAR.sslip.io

POSTGRES_USER=tacama_user
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=tacamamesa
REDIS_PASSWORD=CAMBIAR
RABBITMQ_USER=tacama_mq
RABBITMQ_PASSWORD=CAMBIAR
RABBITMQ_VHOST=tacamamesa

JWT_SECRET=CAMBIAR_64_CARACTERES
JWT_MESA_SECRET=CAMBIAR_64_CARACTERES
JWT_EXPIRES_IN=8h
JWT_MESA_EXPIRES_IN=4h

# Dominios de Vercel separados por coma, sin espacios
CORS_ORIGINS=https://TU-COMENSAL.vercel.app,https://TU-STAFF.vercel.app

BODEGA_SANDBOX_API_KEY=sandbox_key
